# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored — never commit real keys.
#
# dispatch reads .env from the working directory at startup. Variables already
# set in your shell win, so you can override any of these per-command:
#   LLM_CHAT_MODEL=gpt-4o go run ./cmd/dispatch ask "..."

# --- Required -----------------------------------------------------------

# OpenAI-compatible endpoint, including the /v1 suffix.
LLM_BASE_URL=https://api.openai.com/v1

# Bearer token for the endpoint above. Leave empty for local servers that
# don't check it (Ollama, llama.cpp, LM Studio).
LLM_API_KEY=sk-replace-me

# --- Optional -----------------------------------------------------------

# Chat model: judges evidence sufficiency, routes, and generates answers.
# Prefer a NON-thinking model. A reasoning model spends its output budget
# thinking before answering — measured locally, ~880 characters of reasoning
# for a one-sentence reply — which is both slow and the cause of empty
# completions on long prompts. qwen2.5:7b matched a 9.6 GB thinking model on
# routing accuracy and answer quality at half the time and half the memory.
LLM_CHAT_MODEL=gpt-4o-mini

# Optional: a smaller model for the mechanical passes — context sentences,
# entity extraction, summaries, coreference. These dominate ingest and none of
# them reason. On a local setup this was ~11x faster than using the chat model,
# and produced a slightly better index. Unset, the chat model does everything.
# LLM_UTILITY_MODEL=llama3.2:3b

# Embedding model. This must be a model built for embeddings — a chat model
# cannot do it. Ollama replies "This server does not support embeddings" if you
# point this at a chat model, so it needs its own `ollama pull`.
# Changing this invalidates any saved index — `dispatch ask` will refuse to load
# an index built with a different one. Re-run ingest.
LLM_EMBED_MODEL=text-embedding-3-small

# --- Local alternatives (uncomment one) ---------------------------------

# Ollama — needs an embedding model of its own; a chat model cannot embed.
#   ollama pull qwen2.5:7b && ollama pull llama3.2:3b && ollama pull nomic-embed-text
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_CHAT_MODEL=qwen2.5:7b
# LLM_UTILITY_MODEL=llama3.2:3b
# LLM_EMBED_MODEL=nomic-embed-text

# LM Studio
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=

# mlx-openai-server (Apple silicon)
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=
