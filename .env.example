# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored — never commit real keys.
#
# dispatch reads .env from the working directory at startup. Variables already
# set in your shell win, so you can override any of these per-command:
#   LLM_CHAT_MODEL=gpt-4o go run ./cmd/dispatch ask "..."

# --- Required -----------------------------------------------------------

# OpenAI-compatible endpoint, including the /v1 suffix.
LLM_BASE_URL=https://api.openai.com/v1

# Bearer token for the endpoint above. Leave empty for local servers that
# don't check it (Ollama, llama.cpp, LM Studio).
LLM_API_KEY=sk-replace-me

# --- Optional -----------------------------------------------------------

# Chat model: judges evidence sufficiency, routes, and generates answers.
# Prefer a NON-thinking model. A reasoning model spends its output budget
# thinking before answering — measured locally, ~880 characters of reasoning
# for a one-sentence reply — which is both slow and the cause of empty
# completions on long prompts. qwen2.5:7b matched a 9.6 GB thinking model on
# routing accuracy and answer quality at half the time and half the memory.
LLM_CHAT_MODEL=gpt-4o-mini

# Optional: a smaller model for the mechanical passes — context sentences,
# entity extraction, summaries, coreference. These dominate ingest and none of
# them reason. On a local setup this was ~11x faster than using the chat model,
# and produced a slightly better index. Unset, the chat model does everything.
# LLM_UTILITY_MODEL=llama3.2:3b

# Embedding model. This must be a model built for embeddings — a chat model
# cannot do it. Ollama replies "This server does not support embeddings" if you
# point this at a chat model, so it needs its own `ollama pull`.
# Changing this invalidates any saved index — `dispatch ask` will refuse to load
# an index built with a different one. Re-run ingest.
LLM_EMBED_MODEL=text-embedding-3-small

# --- Local alternatives (uncomment one) ---------------------------------

# Ollama — the measured recommendation. Three roles, three models:
#   ollama pull qwen2.5:7b && ollama pull llama3.2:3b && ollama pull nomic-embed-text
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_CHAT_MODEL=qwen2.5:7b        # non-thinking; matches a 9.6GB reasoning
#                                  # model on routing and answers, half the time
# LLM_UTILITY_MODEL=llama3.2:3b    # ~11x faster on ingest, and a better index
# LLM_EMBED_MODEL=nomic-embed-text
#
# All three together are ~7 GB and stay resident on a 16 GB machine. A 9.6 GB
# answering model evicts the others and they reload on every switch.

# LM Studio
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=

# mlx-openai-server (Apple silicon)
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=

# ---------------------------------------------------------------------------
# Reranking (optional, off by default)
# ---------------------------------------------------------------------------
# `ask --rerank` and `eval retrieval --rerank` score the shortlist with a
# purpose-built cross-encoder over an HTTP /rerank endpoint. Cohere, Jina and
# Voyage all speak this shape, as does a local bge-reranker behind
# text-embeddings-inference.
#
# Reranking with a general CHAT model measured worse than no reranking at all,
# twice — that path is `--rerank-llm` and should stay unused. A cross-encoder is
# a different kind of model, not a bigger one. Measure before trusting it:
#
#   dispatch eval retrieval -k 5              # baseline
#   dispatch eval retrieval -k 5 --rerank     # with the cross-encoder
#
# Local, via text-embeddings-inference or infinity:
# RERANK_BASE_URL=http://localhost:7997
# RERANK_MODEL=BAAI/bge-reranker-base      # English
# RERANK_MODEL=BAAI/bge-reranker-v2-m3     # multilingual, ~2x the parameters
#
# RERANK_TIMEOUT caps one rerank request; the default is 60s. A large
# cross-encoder scoring 20 passages on CPU can exceed that, and the failure
# reads like a broken endpoint rather than a slow one.
# RERANK_TIMEOUT=5m
#
# Hosted:
# RERANK_BASE_URL=https://api.cohere.com/v2
# RERANK_API_KEY=
# RERANK_MODEL=rerank-v3.5
